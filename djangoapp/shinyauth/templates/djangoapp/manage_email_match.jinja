{% extends 'base.jinja' %}

{% block content %}

  <div class="container mt-3 mb-5">
    {% if create %}
      <h2>{{ tm("create_new_email_match") }}</h2>
    {% else %}
      <h2>{{ tm("manage_email_match") }}: {{ match }}</h2>
    {% endif %}
    <hr>
    <form method="POST">
      {% csrf_token %}
      <div class="row mt-3">
        <div class="col">
          <label for="match" class="form-label">{{ tm("email_match_required") }}</label>
          <input type="text" class="form-control" id="match" name="match"
                 value="{{ match.match or '' }}">
        </div>
        <div class="col">
          <label for="match_type" class="form-label">{{ tm("match_type") }}</label>
          {{ form.match_type }}
        </div>
      </div>
      <div class="form-group mt-3">
        <label for="name" class="form-label">{{ tm("display_name_optional") }}</label>
        <input type="text" class="form-control" id="name" name="name"
               value="{{ match.name }}">
      </div>
      {# Checkbox to also create a user group with this match #}
      {% if create %}
        <div class="form-group mt-3">
          <input type="checkbox" class="form-check-input" id="create_group" name="create_group" checked>
          <label for="create_group" class="form-check-label">{{ tm("create_user_group_recommended") }}</label>
        </div>
      {% endif %}
      <div class="row mt-3">
        <div class="col">
          <button type="submit" class="btn btn-primary">{{ tm("submit_button") }}</button>
          <a href="{{ url("manage_users") }}" type="button" class="btn btn-secondary">{{ tm("cancel_button") }}</a>
        </div>
        {% if not create %}
          <div class="col-auto">
            <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                  data-bs-target="#deleteModal">
              {{ tm("delete_button") }}
            </button>
          </div>
        {% endif %}
      </div>
    </form>
    {% if not create %}
      <!-- Modal -->
      <div class="modal" tabindex="-1" id="deleteModal">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">{{ tm("confirm_delete") }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p>{{ tm("confirm_delete_message") }}</p>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ tm("close_button") }}</button>
              <form method="POST" action="{{ url("delete_email_match", match.id)}}">
                {% csrf_token %}
                <button type="submit" class="btn btn-danger">{{ tm("delete_email_match_button") }}</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
    
  </div>
{% endblock %}
